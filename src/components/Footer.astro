---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const annee = new Date().getFullYear();
---

<footer class="mt-24 border-t border-sand-200 bg-sand-100">
  <div class="mx-auto grid max-w-5xl gap-10 px-5 py-14 sm:grid-cols-2 md:grid-cols-3">
    <div>
      <p class="font-serif text-lg">Amandine Barlatier</p>
      <p class="mt-1 text-sm text-ink-soft">
        Coach professionnelle — Institut Maïeutis<br />
        Accompagnement individuel, d'équipe et d'organisation.
      </p>
    </div>

    <div class="text-sm">
      <p class="mb-3 font-medium uppercase tracking-[0.12em] text-ink-soft">Le site</p>
      <ul class="space-y-2">
        <li><a class="hover:text-petrol-600" href={`${base}/a-propos/`}>À propos</a></li>
        <li><a class="hover:text-petrol-600" href={`${base}/accompagnements/`}>Accompagnements</a></li>
        <li><a class="hover:text-petrol-600" href={`${base}/contact/`}>Contact</a></li>
        <li><a class="hover:text-petrol-600" href={`${base}/mentions-legales/`}>Mentions légales</a></li>
      </ul>
    </div>

    <div class="text-sm">
      <p class="mb-3 font-medium uppercase tracking-[0.12em] text-ink-soft">Contact</p>
      <ul class="space-y-2 text-ink-soft">
        <!-- TODO: à compléter (voir contenu/A-COMPLETER.md) -->
        <li>Email : <span class="text-ink">à venir</span></li>
        <li><a class="hover:text-petrol-600" href={`${base}/contact/`}>Réserver un appel découverte</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-sand-200">
    <div class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-5 text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between">
      <p>© {annee} Amandine Barlatier. Tous droits réservés.</p>
      <p>Les données transmises via ce site ne servent qu'à répondre à votre demande.</p>
    </div>
  </div>
</footer>
