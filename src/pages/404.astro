---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Page introuvable"
  description="La page que vous cherchez n'existe pas ou a été déplacée."
  path="/404/"
>
  <section class="mx-auto flex max-w-3xl flex-col items-start px-5 py-24">
    <p class="text-xs uppercase tracking-[0.18em] text-petrol-600">Erreur 404</p>
    <h1 class="mt-4 text-4xl">Cette page n'existe pas.</h1>
    <p class="mt-5 text-lg text-ink-soft">
      Le lien est peut-être obsolète. Vous pouvez revenir à l'accueil, ou aller directement à l'essentiel :
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href={`${base}/`} class="rounded-full bg-petrol-600 px-6 py-3 font-medium text-sand-50 hover:bg-petrol-700">
        Retour à l'accueil
      </a>
      <a href={`${base}/contact/`} class="rounded-full border border-sand-300 px-6 py-3 font-medium hover:border-petrol-600 hover:text-petrol-600">
        Réserver un appel découverte
      </a>
    </div>
  </section>
</BaseLayout>
