---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export async function getStaticPaths() {
  const accompagnements = await getCollection('accompagnements', ({ data }) => !data.brouillon);
  return accompagnements.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.titre}
  description={entry.data.resume}
  path={`/accompagnements/${entry.id}/`}
>
  <article class="mx-auto max-w-5xl px-5 pb-16 pt-16">
    <a href={`${base}/accompagnements/`} class="text-sm text-ink-soft hover:text-petrol-600">← Tous les accompagnements</a>

    <p class="mt-8 text-xs uppercase tracking-[0.18em] text-petrol-600">{entry.data.pourQui}</p>
    <h1 class="mt-4 max-w-3xl text-4xl leading-[1.15] sm:text-5xl">{entry.data.titre}</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-soft">{entry.data.resume}</p>

    <div class="prose-page mt-12">
      <Content />
    </div>

    {entry.data.dossier && (
      <div class="mt-10 rounded-lg border border-sand-200 bg-sand-50 p-6">
        <h2 class="font-serif text-xl">Le dossier complet</h2>
        <p class="mt-2 text-sm text-ink-soft">
          Contexte, méthode, calendrier, financements et présentation des intervenantes : le parcours en détail.
        </p>
        <a
          href={`${base}${entry.data.dossier}`}
          class="mt-4 inline-block text-sm font-medium text-petrol-600 hover:underline"
        >
          Télécharger le dossier (PDF) →
        </a>
      </div>
    )}

    <div class="mt-14 rounded-lg border border-sand-200 bg-white p-8">
      <h2 class="font-serif text-2xl">On en parle ?</h2>
      <p class="mt-3 text-ink-soft">
        Un appel de 30 minutes suffit pour savoir si cet accompagnement correspond à ce que vous vivez.
      </p>
      <a
        href={`${base}/contact/`}
        class="mt-6 inline-block rounded-full bg-petrol-600 px-6 py-3 font-medium text-sand-50 transition-colors hover:bg-petrol-700"
      >
        Réserver un appel découverte
      </a>
    </div>
  </article>
</BaseLayout>
