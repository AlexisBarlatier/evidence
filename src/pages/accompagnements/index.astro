---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const accompagnements = (await getCollection('accompagnements', ({ data }) => !data.brouillon))
  .sort((a, b) => a.data.ordre - b.data.ordre);
---

<BaseLayout
  title="Accompagnements"
  description="Coaching individuel pour managers et dirigeants, coaching d'équipe, accompagnement d'organisation : trois façons de travailler ensemble, selon ce que vous vivez aujourd'hui."
  path="/accompagnements/"
>
  <section class="mx-auto max-w-5xl px-5 pb-4 pt-16">
    <p class="text-xs uppercase tracking-[0.18em] text-petrol-600">Accompagnements</p>
    <h1 class="mt-4 max-w-3xl text-4xl leading-[1.15] sm:text-5xl">Trois façons de travailler ensemble.</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-soft">
      Chaque accompagnement commence par le même endroit : comprendre ce que vous vivez aujourd'hui,
      et ce que vous voulez voir changer.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-12">
    <div class="grid gap-6 md:grid-cols-3">
      {
        accompagnements.map((a) => (
          <a
            href={`${base}/accompagnements/${a.id}/`}
            class="group flex flex-col rounded-lg border border-sand-200 bg-white p-6 transition-colors hover:border-petrol-600"
          >
            <p class="text-xs uppercase tracking-[0.14em] text-ink-soft">{a.data.pourQui}</p>
            <h2 class="mt-3 font-serif text-2xl group-hover:text-petrol-600">{a.data.titre}</h2>
            <p class="mt-3 flex-1 text-sm text-ink-soft">{a.data.resume}</p>
            <span class="mt-5 text-sm font-medium text-petrol-600">En savoir plus →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-t border-sand-200 bg-white">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center">
      <h2 class="text-3xl">Vous hésitez entre deux formats ?</h2>
      <p class="mt-4 text-ink-soft">
        C'est précisément le sujet de l'appel découverte : on regarde ensemble ce qui est le plus utile,
        pour vous et pour votre équipe.
      </p>
      <a
        href={`${base}/contact/`}
        class="mt-8 inline-block rounded-full bg-petrol-600 px-7 py-3 font-medium text-sand-50 transition-colors hover:bg-petrol-700"
      >
        Réserver un appel découverte
      </a>
    </div>
  </section>
</BaseLayout>
